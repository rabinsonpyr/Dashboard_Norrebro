# Copy this file to .streamlit/secrets.toml for LOCAL testing only.
# On Streamlit Community Cloud, set these instead under:
#   Your app → Settings → Secrets
# Never commit a real secrets.toml to GitHub.

APP_PASSWORD = "choose-a-password"
GOOGLE_DRIVE_FILE_ID = "paste-the-file-id-here"

# Paste the contents of your downloaded service account JSON key here,
# converting each field to a TOML line. See README.md for full steps.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "your-private-key-id"
private_key = """-----BEGIN PRIVATE KEY-----
paste-the-full-multiline-key-here
-----END PRIVATE KEY-----
"""
client_email = "your-service-account@your-project.iam.gserviceaccount.com"
client_id = "your-client-id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "your-cert-url"
